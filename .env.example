# ─── App ────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Atlas AI
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-random-64-char-secret
FRONTEND_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://atlas:atlas_dev_password@postgres:5432/atlas_ai
DATABASE_SYNC_URL=postgresql://atlas:atlas_dev_password@postgres:5432/atlas_ai

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Qdrant ──────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ─── Storage (MinIO / S3) ────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=atlas-ai
S3_REGION=us-east-1

# ─── AI Provider ─────────────────────────────────────────
# Required for AI features. Use your own key; never commit the real value.
GROQ_API_KEY=your-own-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── JWT ─────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ─── Email ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@atlas-ai.com

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# ─── Security ────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
