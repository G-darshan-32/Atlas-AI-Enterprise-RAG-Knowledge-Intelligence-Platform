# ─── Copy these into Railway environment variables ───────
# DO NOT commit actual values

APP_ENV=production
APP_NAME=Atlas AI
APP_VERSION=1.0.0
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
FRONTEND_URL=https://your-app.vercel.app
DEBUG=false

# Neon PostgreSQL (copy from Neon dashboard → Connection string)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/atlas_ai?sslmode=require
DATABASE_SYNC_URL=postgresql://user:pass@ep-xxx.neon.tech/atlas_ai?sslmode=require

# Upstash Redis (copy from Upstash dashboard → REST URL format won't work, use Redis URL)
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
CELERY_BROKER_URL=rediss://default:xxx@xxx.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:xxx@xxx.upstash.io:6379/2

# Qdrant Cloud (copy from Qdrant Cloud dashboard)
QDRANT_URL=https://xxx.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>

# Cloudflare R2 (from R2 dashboard → Manage API tokens)
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
S3_BUCKET_NAME=atlas-ai
S3_REGION=auto

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — your Vercel frontend URL
ALLOWED_ORIGINS=https://your-app.vercel.app

# OAuth (optional — set up Google/GitHub apps later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api.railway.app/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-api.railway.app/api/v1/auth/github/callback

# Email (optional — skip for now, email features will be silent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@atlas-ai.com

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
MAX_UPLOAD_SIZE_MB=50
